# Copy to .env — loaded by docker compose (env_file).

# Host port for the unified API + /admin WebUI service
GENERALCOMPUTE2API_HOST_PORT=7999

# Pool WebUI login (required)
GENERALCOMPUTE2API_ADMIN_TOKEN=zqt1125

# SQLite database file
# GENERALCOMPUTE2API_DATABASE_PATH=docker-data/generalcompute2api/generalcompute2api.db

# Optional: cap accounts per gateway key (0 = unlimited)
# GENERALCOMPUTE2API_POOL_MAX_ACCOUNTS_PER_KEY=0

# Disable appending the default thinking prompt to user messages (when request thinking=true)
GENERALCOMPUTE2API_THINKING_INJECTION_ENABLED=0
